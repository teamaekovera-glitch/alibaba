    "seed": "tsx src/cli/seed-cli.ts",
    "fixtures:importer": "tsx scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
