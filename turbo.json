{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      // Upstream typechecks first — @packsource/core resolves the generated
      // Prisma client types through @packsource/db.
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:integration": {}
  }
}
